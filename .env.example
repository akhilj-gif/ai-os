# Copy to .env — dev defaults match infra/docker-compose.yml
DATABASE_URL=postgresql://postgres:aios@localhost:5432/aios
REDIS_URL=redis://localhost:6379
API_PORT=4000

# Model provider — set ONE key (priority: Anthropic > xAI > Gemini). ADR-0002.
# xAI/Grok uses the Anthropic-compatible Messages API; Gemini uses its OpenAI-compatible
# endpoint (free tier — get a key at https://aistudio.google.com/apikey).
ANTHROPIC_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
# Optional second Gemini key — the router rotates to it on 429 (free-tier quota relief)
GEMINI_API_KEY_FALLBACK=
# Groq (gsk_ keys — NOT xAI Grok). OpenAI-compatible, generous free tier, fast Llama
# models with tool-calling. Good for eval-gym runs. Force with MODEL_PROVIDER=groq.
GROQ_API_KEY=
# NVIDIA NIM (nvapi- keys — https://build.nvidia.com). OpenAI-compatible, hosts
# open models (Llama/DeepSeek/Qwen/...). ADR-0019 routes coding/general-chat/
# open-source-reasoning tasks here first.
NVIDIA_API_KEY=
# Force a specific provider (anthropic|xai|gemini|nvidia|groq), overriding
# capability-based auto-routing (ADR-0019).
MODEL_PROVIDER=

# Langfuse self-host (headless-initialized by docker-compose — these dev keys just work)
LANGFUSE_HOST=http://localhost:3030
LANGFUSE_PUBLIC_KEY=pk-lf-aios-dev
LANGFUSE_SECRET_KEY=sk-lf-aios-dev

# Google OAuth (Gmail + Calendar read/draft — M1 tool, ADR-0003)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/oauth/google/callback

# Uber ride booking (M14c, ADR-0017). Register an app at developer.uber.com,
# add YOUR OWN Uber account as an authorized user (self-booking needs no Uber
# approval), set the redirect URI below in the app, then fill these and visit
# http://localhost:4000/oauth/uber to connect. Books rides on your account;
# every booking is still approval-gated in the OS.
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_REDIRECT_URI=http://localhost:4000/oauth/uber/callback

# User timezone for "today" semantics (calendar defaults, system prompt clock)
AIOS_TZ=Asia/Kolkata

# Model routing table (blueprint §5) — uncomment to override the provider defaults
# (Anthropic: haiku/sonnet/fable · xAI: grok-4-fast-non-reasoning/grok-4-fast-reasoning/grok-4)
# MODEL_ROUTING=
# MODEL_EXECUTION=
# MODEL_PLANNING=

# Browser automation bridge (M15b, ADR-0018). Set once the Playwright bridge
# is running (pnpm --filter @ai-os/browser-bridge start, or pm2 ai-os-browser).
# Unset = the browser pack uses its mock fixture site.
BROWSER_BRIDGE_URL=http://127.0.0.1:4200
