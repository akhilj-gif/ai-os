{"nodes": [{"id": "docs_adr_0008_secrets_broker_secrets_broker", "label": "ADR-0008: Secrets broker & audit redaction", "file_type": "rationale", "source_file": "docs/adr/0008-secrets-broker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SecretsBroker is the one sanctioned door for reading env secrets. redactForAudit() scrubs known secret values + secret-shaped patterns (GOCSPX-, xai-, gsk_, sk-, ya29., postgres URLs, Bearer tokens) from tool_calls before they hit the append-only audit log, so even a leaked token can't be written to the log in the clear."}], "edges": [{"source": "docs_blueprint_m5", "target": "docs_adr_0008_secrets_broker_secrets_broker", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0008-secrets-broker.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0008_secrets_broker_secrets_broker", "target": "packages_trust_src_secrets_secretsbroker", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0008-secrets-broker.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0008_secrets_broker_secrets_broker", "target": "packages_trust_src_secrets_redactforaudit", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0008-secrets-broker.md", "source_location": null, "weight": 1.0}], "hyperedges": []}